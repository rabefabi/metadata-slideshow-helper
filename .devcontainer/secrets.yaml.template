# Home Assistant Secrets Template for Development
# This file serves as a template for .devcontainer/secrets.yaml
# 
# To use:
# 1. Copy this file to .devcontainer/secrets.yaml (git-ignored)
# 2. Reference secrets in configuration.yaml using: !secret key_name
# 3. Values will be substituted when configuration is processed
#
# Note: This template file IS committed to repository as documentation.
# Actual secrets.yaml files should never be committed.

# API/Integration credentials
api_password: development-password

# Home location (for weather, sun calculations, etc.)
# Default: Amsterdam, Netherlands
latitude: 52.3676
longitude: 4.9041
